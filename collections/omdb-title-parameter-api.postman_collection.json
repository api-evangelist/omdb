                  "description": "(Required) Title of movie or series"
                },
                {
                  "disabled": false,
                  "key": "y",
                  "value": "<integer>",
                  "description": "Year of release"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Return movie or series"
                },
                {
                  "disabled": false,
                  "key": "plot",
                  "value": "<string>",
                  "description": "Return short or full plot"
                },
                {
                  "disabled": false,
                  "key": "r",
